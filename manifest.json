{
  "manifest_version": 3,
  "name": "Sitemap Raw Viewer",
  "version": "1.1",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.solarwinds.com/*.xml*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}